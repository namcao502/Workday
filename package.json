{
  "name": "workday",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @workday/server\" \"npm run dev -w @workday/client\"",
    "build": "tsc -b packages/core/tsconfig.build.json packages/server/tsconfig.build.json && npm run build -w @workday/client",
    "start": "node --env-file-if-exists=.env packages/server/dist/main.js",
    "import-wpf": "npm run import-wpf -w @workday/server --",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
